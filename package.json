{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build --compile --target bun --outfile server src/index.ts",
    "drizzle:generate": "bunx drizzle-kit generate",
    "drizzle:migrate": "bunx drizzle-kit migrate",
    "drizzle:push": "bunx drizzle-kit push",
    "db:reset": "bun run scripts/reset-data.ts",
    "seed:fleet": "bun run src/scripts/seed-fleet.ts",
    "seed:pricing": "bun run src/scripts/seed-pricing.ts",
    "seed": "bun run src/scripts/seed-fleet.ts && bun run src/scripts/seed-pricing.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.31.10",
    "postgres": "^3.4.9"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@elysia/openapi": "^1.4.15",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/jwt": "^1.4.1",
    "better-auth": "^1.6.5",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.28",
    "elysia-rate-limit": "^4.6.2",
    "libsql": "^0.5.29",
    "nanoid": "^5.1.9",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "razorpay": "^2.9.6"
  }
}
